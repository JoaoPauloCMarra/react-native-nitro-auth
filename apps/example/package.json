{
  "name": "example",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "env -u NO_COLOR expo start -d",
    "ios": "env -u NO_COLOR expo run:ios",
    "android": "env -u NO_COLOR expo run:android",
    "prebuild": "env -u NO_COLOR expo prebuild",
    "prebuild:clean": "env -u NO_COLOR expo prebuild --clean",
    "format:check": "eslint .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "install-check": "env -u NO_COLOR expo install --check",
    "doctor": "bunx expo-doctor@latest",
    "config:introspect": "env -u NO_COLOR expo config --type introspect --json > /tmp/nitro-auth-expo-config.json",
    "android:assemble": "cd android && NODE_ENV=development ./gradlew --no-daemon --no-configuration-cache -PreactNativeArchitectures=arm64-v8a :app:assembleDebug",
    "ios:build": "cd ios && pod install && xcodebuild -workspace NitroAuth.xcworkspace -scheme NitroAuth -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "dotenv": "^17.4.2",
    "expo": "~57.0.9",
    "expo-asset": "~57.0.8",
    "expo-build-properties": "~57.0.8",
    "expo-constants": "~57.0.8",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-auth": "workspace:*",
    "react-native-nitro-modules": "0.36.4",
    "react-native-nitro-storage": "^0.6.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-worklets": "0.10.1",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~57.0.5",
    "eslint": "^10.8.0",
    "eslint-config-expo-magic": "^3.0.0"
  }
}
