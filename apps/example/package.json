{
  "name": "example",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "env -u NO_COLOR expo start -d",
    "ios": "env -u NO_COLOR expo run:ios",
    "android": "bun run android:assemble && env -u NO_COLOR expo run:android --binary android/app/build/outputs/apk/debug/app-debug.apk",
    "prebuild": "env -u NO_COLOR expo prebuild",
    "prebuild:clean": "env -u NO_COLOR expo prebuild --clean",
    "format:check": "eslint .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "install-check": "env -u NO_COLOR expo install --check",
    "doctor": "bunx expo-doctor@1.21.5",
    "config:introspect": "env -u NO_COLOR expo config --type introspect --json > /tmp/nitro-auth-expo-config.json",
    "android:assemble": "cd android && NODE_ENV=development ./gradlew --no-daemon --no-configuration-cache -PreactNativeArchitectures=arm64-v8a :app:assembleDebug",
    "ios:build": "cd ios && pod install && xcodebuild -workspace NitroAuth.xcworkspace -scheme NitroAuth -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.10",
    "dotenv": "^18.0.8",
    "expo": "~58.0.16",
    "expo-asset": "~58.0.17",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.24",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-nitro-auth": "workspace:*",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "babel-preset-expo": "~58.0.18",
    "eslint": "^10.13.0",
    "eslint-config-expo-magic": "^5.5.0"
  }
}
