{
  "name": "react-native-nitro-auth-monorepo",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "eslint": "^10.8.1",
    "eslint-config-expo-magic": "^3.0.2",
    "jest": "^29.7.0",
    "nitrogen": "0.37.1",
    "react-native-builder-bob": "^0.43.0",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "caniuse-lite": "1.0.30001810",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-web": "^0.21.2",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-worklets": "0.10.1",
    "expo": "~57.0.25",
    "expo-asset": "~57.0.18",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.19",
    "expo-linking": "~57.0.11",
    "expo-font": "~57.0.4",
    "@expo/log-box": "~57.0.4",
    "@expo/dom-webview": "~57.0.1"
  },
  "packageManager": "bun@1.3.14",
  "private": true,
  "scripts": {
    "setup": "bun scripts/setup.js",
    "publish-package": "bun scripts/publish.js",
    "publish-package:dry-run": "bun scripts/publish.js --dry-run --skip-checks",
    "sync-package-docs": "bun scripts/sync-package-docs.ts",
    "verify:core-versions": "bun scripts/verify-core-versions.ts",
    "verify:codegen": "bun scripts/verify-codegen.ts",
    "dev": "bun run example:start",
    "build": "bun run --cwd packages/react-native-nitro-auth build",
    "codegen": "bun run --cwd packages/react-native-nitro-auth codegen",
    "clean": "bun run --cwd packages/react-native-nitro-auth clean",
    "format:check": "bun run --cwd packages/react-native-nitro-auth format:check",
    "lint": "bun run --cwd packages/react-native-nitro-auth lint",
    "typecheck": "bun run --cwd packages/react-native-nitro-auth typecheck",
    "typecheck:rn087": "bun scripts/verify-rn087-types.ts",
    "test": "bun run --cwd packages/react-native-nitro-auth test",
    "test:types": "bun run typecheck",
    "test:lifecycle": "node scripts/package-doc-lifecycle.test.js && bun scripts/assert-publish-workflow.js && bun test ./scripts/assert-publish-workflow.test.js",
    "test:coverage": "bun run --cwd packages/react-native-nitro-auth test -- --coverage",
    "test:cpp": "bun run --cwd packages/react-native-nitro-auth test:cpp",
    "check": "bun run lint && bun run test:types && bun run test && bun run test:lifecycle",
    "check:ci": "bun run verify:core-versions && bun run verify:codegen && bun run build && bun run check && bun run test:cpp && bun run typecheck:rn087",
    "audit:package": "bun scripts/sync-package-docs.ts --check && bun scripts/check-social-button-assets.ts && bun scripts/check-pack-contents.js",
    "example:lint": "bun run --cwd apps/example lint",
    "example:typecheck": "bun run --cwd apps/example typecheck",
    "example:check": "bun run example:lint && bun run example:typecheck && bun run example:install-check && bun run example:doctor && bun run example:config",
    "example:start": "bun run --cwd apps/example start",
    "example:ios": "bun run --cwd apps/example ios",
    "example:android": "bun run --cwd apps/example android",
    "example:prebuild": "bun run --cwd apps/example prebuild",
    "example:prebuild:clean": "bun run --cwd apps/example prebuild:clean",
    "example:android:assemble": "bun run --cwd apps/example android:assemble",
    "android:test": "cd apps/example/android && ./gradlew --no-daemon --no-configuration-cache :react-native-nitro-auth:testDebugUnitTest",
    "example:ios:build": "bun run --cwd apps/example ios:build",
    "example:smoke": "bunx maestro test maestro/smoke-tests.yaml",
    "example:e2e": "agent-device test e2e/qa-full-features.ad --retries 1",
    "example:e2e:android": "agent-device test e2e/qa-full-features.ad --device \"RN Expo MidRange\" --retries 1",
    "example:e2e:ios": "agent-device test e2e/qa-full-features.ad --device \"iPhone 17 Pro Max (iOS 26.5)\" --retries 1",
    "example:e2e:deeplink": "agent-device test e2e/qa-deeplink.ad --retries 1",
    "example:e2e:deeplink:android": "agent-device test e2e/qa-deeplink.ad --device \"RN Expo MidRange\" --retries 1",
    "example:e2e:deeplink:ios": "agent-device test e2e/qa-deeplink.ad --device \"iPhone 17 Pro Max (iOS 26.5)\" --retries 1",
    "example:install-check": "bun run --cwd apps/example install-check",
    "example:doctor": "bun run --cwd apps/example doctor",
    "example:config": "bun run --cwd apps/example config:introspect",
    "release:preflight": "bun run check:ci && bun run format:check && bun run example:check && bun run audit:package && bun run publish-package:dry-run",
    "example:smoke:ci": "node scripts/assert-example-smoke.js"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
