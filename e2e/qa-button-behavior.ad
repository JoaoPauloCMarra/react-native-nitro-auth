open "com.auth.example" "auth://e2e-buttons" --relaunch
wait "stable"
wait id="e2e-buttons-screen"
scroll down 0.4 --until "id=\"gallery-probe\""
wait id="gallery-probe"
wait text "icon-size=48x48:"
scroll down 0.4 --until "id=\"gallery-disabled\""
press id="gallery-disabled"
wait id="gallery-probe"
wait text "disabled-press=0:"
scroll down 0.4 --until "id=\"gallery-busy\""
press id="gallery-busy"
press id="gallery-busy"
wait text "busy-press=1:"
scroll down 0.4 --until "id=\"gallery-error\""
press id="gallery-error"
wait text "onError=timeout:"
scroll down 0.4 --until "id=\"gallery-microsoft\""
press id="gallery-microsoft"
wait text "ms-press=1:"
scroll down 0.4 --until "id=\"gallery-observer-loading\""
press id="gallery-observer-loading"
wait text "pkg-busy=true:pkg-disabled=true:"
scroll down 0.4 --until "id=\"gallery-observer-loading\""
press id="gallery-observer-loading"
wait text "pkg-busy=false:pkg-disabled=false:"
close
