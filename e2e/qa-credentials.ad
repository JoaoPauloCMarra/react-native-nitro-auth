open "com.auth.example" "auth://e2e-credentials" --relaunch
wait "stable"
wait id="e2e-credentials-screen"
wait text "e2e-ready"
press id="e2e-credentials-nonce-run"
wait text "ok:raw="
press id="e2e-credentials-capabilities-run"
wait text "ok:"
press id="e2e-credentials-snapshot-run"
wait text "ok:rev="
wait text "user=none"
close
