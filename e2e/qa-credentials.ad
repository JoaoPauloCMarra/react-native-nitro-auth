open "com.auth.example" "auth://e2e-credentials" --relaunch
wait "stable"
wait id="e2e-credentials-screen"
wait id="e2e-credentials-ready"
wait text "e2e-ready"
wait id="e2e-credentials-nonce"
wait text "ok:nonce=raw-base64url-43:hashed-sha256-hex-64"
wait id="e2e-credentials-capabilities"
wait text "ok:provider-capability-matrix=match"
wait id="e2e-credentials-snapshot"
wait text "ok:session=user=none:scopes=0:revision=safe-integer"
close
