open "com.auth.example" --relaunch
wait "stable"
wait id="open-e2e-lab"
press id="open-e2e-lab"
wait id="e2e-screen"
wait text "e2e-ready"
press label="Show custom buttons"
press id="gallery-google"
wait text "Last visual button pressed: Google"
press label="Show image buttons"
press id="gallery-apple"
wait text "Last visual button pressed: Apple"
press label="Show svg buttons"
press id="gallery-google"
wait text "Last visual button pressed: Google"
press label="Toggle icon-only buttons"
press id="gallery-apple"
wait text "Last visual button pressed: Apple"
press label="Toggle button appearance"
press label="Toggle button shape"
press id="gallery-google"
wait text "Last visual button pressed: Google"
press label="Toggle button loading"
wait id="gallery-loading-active"
press label="Toggle button loading"
press label="Toggle icon-only buttons"
press label="Toggle button appearance"
press label="Toggle button shape"
scroll down
wait text "signed-out"
press id="e2e-capabilities-run"
wait id="e2e-capabilities"
wait text "ok:provider-capability-matrix=match"
press id="e2e-api-run"
wait id="e2e-api-status"
wait text "ok:session=user=none:scopes=0:revision="
press id="e2e-get-token"
wait id="e2e-session-action"
wait text "ok:access-token=undefined"
press id="e2e-scopes-run"
wait id="e2e-scopes-status"
wait text "ok:revokeScopes=resolved:revokedScopes=0:revokedAtProvider=false:revokeAccess=not_signed_in"
press id="e2e-events-run"
wait id="e2e-events"
wait text "ok:auth-event-listener=received:"
press id="e2e-run-stress"
wait id="e2e-stress-result"
wait text "ok:provider-capability-matrix-repeat=40"
scroll down
wait id="smoke-run-all"
press id="smoke-run-all"
wait id="smoke-summary"
wait text "Deterministic checks: PASS; provider acceptance: PENDING"
wait id="smoke-start-from-a-signed-out-example-session-status"
wait text "PASS:start-from-a-signed-out-example-session"
wait id="smoke-capabilities-describe-every-provider-on-this-platform-status"
wait text "PASS:capabilities-describe-every-provider-on-this-platform"
wait id="smoke-atomic-snapshot-agrees-with-legacy-getters-status"
wait text "PASS:atomic-snapshot-agrees-with-legacy-getters"
wait id="smoke-snapshot-and-user-events-survive-a-throwing-listener-status"
wait text "PASS:snapshot-and-user-events-survive-a-throwing-listener"
wait id="smoke-unsubscribe-stops-later-callbacks-and-is-idempotent-status"
wait text "PASS:unsubscribe-stops-later-callbacks-and-is-idempotent"
wait id="smoke-operation-events-correlate-failure-and-omit-provider-details-status"
wait text "PASS:operation-events-correlate-failure-and-omit-provider-details"
wait id="smoke-signed-out-scope-revoke-preserves-local-semantics-status"
wait text "PASS:signed-out-scope-revoke-preserves-local-semantics"
wait id="smoke-signed-out-access-token-is-undefined-status"
wait text "PASS:signed-out-access-token-is-undefined"
wait id="smoke-useauth-exposes-signed-out-token-and-revoke-behavior-status"
wait text "PASS:useauth-exposes-signed-out-token-and-revoke-behavior"
wait id="smoke-all-public-error-codes-map-deterministically-status"
wait text "PASS:all-public-error-codes-map-deterministically"
wait id="smoke-logging-can-be-toggled-status"
wait text "PASS:logging-can-be-toggled"
wait id="smoke-silent-restore-handles-the-empty-example-session-status"
wait text "PENDING:silent-restore-handles-the-empty-example-session"
wait id="smoke-google-login-cancellation-or-explicit-setup-gate-status"
wait text "PENDING:google-login-cancellation-or-explicit-setup-gate"
wait id="smoke-google-atomic-login-cancellation-or-explicit-setup-gate-status"
wait text "PENDING:google-atomic-login-cancellation-or-explicit-setup-gate"
wait id="smoke-apple-login-cancellation-or-explicit-setup-gate-status"
wait text "PENDING:apple-login-cancellation-or-explicit-setup-gate"
wait id="smoke-apple-atomic-login-cancellation-or-explicit-setup-gate-status"
wait text "PENDING:apple-atomic-login-cancellation-or-explicit-setup-gate"
wait id="smoke-microsoft-login-cancellation-or-explicit-setup-gate-status"
wait text "PENDING:microsoft-login-cancellation-or-explicit-setup-gate"
wait id="smoke-microsoft-atomic-login-cancellation-or-explicit-setup-gate-status"
wait text "PENDING:microsoft-atomic-login-cancellation-or-explicit-setup-gate"
wait id="smoke-google-credential-cancellation-never-publishes-a-session-status"
wait text "PENDING:google-credential-cancellation-never-publishes-a-session"
wait id="smoke-apple-credential-cancellation-never-publishes-a-session-status"
wait text "PENDING:apple-credential-cancellation-never-publishes-a-session"
wait id="smoke-dispose-cancels-pending-work-and-the-service-recreates-status"
wait text "PENDING:dispose-cancels-pending-work-and-the-service-recreates"
close
